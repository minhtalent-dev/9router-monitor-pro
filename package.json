{
  "name": "9router-monitor-pro",
  "displayName": "9Router Monitor Pro",
  "description": "Track quotas, tokens, and multi-account status of 9Router AI providers directly in the VS Code status bar.",
  "version": "1.0.0",
  "publisher": "minhtalent-dev",
  "author": "Minhtalent-dev",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "9router",
    "token",
    "usage",
    "quota",
    "status bar",
    "monitor",
    "antigravity",
    "gemini",
    "claude"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minhtalent-dev/9router-monitor-pro.git"
  },
  "bugs": {
    "url": "https://github.com/minhtalent-dev/9router-monitor-pro/issues"
  },
  "homepage": "https://github.com/minhtalent-dev/9router-monitor-pro#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiTokenUsage.openQuickMenu",
        "title": "9Router Monitor Pro: Open Interactive Menu"
      },
      {
        "command": "aiTokenUsage.refresh",
        "title": "9Router Monitor Pro: Refresh"
      },
      {
        "command": "aiTokenUsage.setApiKey",
        "title": "9Router Monitor Pro: Set API Key"
      },
      {
        "command": "aiTokenUsage.setConnection",
        "title": "9Router Monitor Pro: Set Connection (URL & Password)"
      },
      {
        "command": "aiTokenUsage.showDetails",
        "title": "9Router Monitor Pro: Show Dashboard"
      },
      {
        "command": "aiTokenUsage.setInterval",
        "title": "9Router Monitor Pro: Set Refresh Interval"
      },
      {
        "command": "aiTokenUsage.setDisplayMode",
        "title": "9Router Monitor Pro: Set Status Bar Display Style"
      }
    ],
    "configuration": {
      "title": "9Router Monitor Pro",
      "properties": {
        "aiTokenUsage.statusDisplayMode": {
          "type": "string",
          "enum": ["compact", "detailed", "minimal"],
          "default": "compact",
          "description": "Status bar display style: compact (balanced), detailed (full ratio + reset times), minimal (ultra-compact numbers only)."
        },
        "aiTokenUsage.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:20128",
          "markdownDescription": "9Router Base URL. Example: `http://localhost:20128` (Local) or `https://rv6v39u.abc-tunnel.us` (Cloudflare Tunnel)."
        },
        "aiTokenUsage.authMode": {
          "type": "string",
          "enum": ["auto", "password", "token"],
          "default": "auto",
          "markdownDescription": "Authentication method: `auto` (auto-detect), `password` (9Router Dashboard Password), or `token` (Session / CLI Token)."
        },
        "aiTokenUsage.providersPath": {
          "type": "string",
          "default": "/api/providers?page=1&pageSize=20&accountStatus=all&sort=priority&isActive=true",
          "markdownDescription": "Endpoint path to fetch providers list. Response must contain `connections`."
        },
        "aiTokenUsage.usagePathTemplate": {
          "type": "string",
          "default": "/api/usage/{id}",
          "markdownDescription": "Endpoint template to fetch usage by provider ID. `{id}` will be replaced with provider ID."
        },
        "aiTokenUsage.statusBarQuota": {
          "type": "string",
          "default": "session",
          "enum": ["session", "weekly"],
          "description": "Default quota to display on status bar when no model is pinned."
        },
        "aiTokenUsage.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "Interval (in seconds) to automatically refresh usage statistics."
        },
        "aiTokenUsage.apiKeyHeader": {
          "type": "string",
          "default": "x-api-key",
          "markdownDescription": "Deprecated. Kept for backward compatibility."
        },
        "aiTokenUsage.apiKeyPrefix": {
          "type": "string",
          "default": "",
          "markdownDescription": "Deprecated. Kept for backward compatibility."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "package:vsix": "vsce package --no-dependencies",
    "compile-tsc": "tsc -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
